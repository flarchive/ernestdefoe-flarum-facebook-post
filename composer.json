{
    "name": "ernestdefoe/flarum-facebook-post",
    "description": "Automatically push new Flarum discussion posts to a Facebook Page",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "suggest": {
        "ernestdefoe/og-image": "Optional. Provides a default Open Graph image via the `ernestdefoe-og-image.default_image` setting, used as a fallback when a discussion has no embedded image."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\FacebookPost\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Facebook Page Auto-Post",
            "category": "integration",
            "icon": {
                "name": "fab fa-facebook",
                "backgroundColor": "#1877F2",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
